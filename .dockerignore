# Build context: only what an image build actually needs is sent to the daemon.
# The dev stack bind-mounts the project over /var/www/html at runtime, so nothing
# below is required inside the image.

# Dependencies — installed in the image or in the running container
node_modules
app/vendor/

# Runtime state and logs — the container writes its own
tmp/
storage/
*.log
npm-debug.log

# Local installation artefacts — a container install creates its own
config.php
pagekit.db
*.db
.env

# Tests, reports and coverage output
tests/
playwright-report/
test-results/
.phpunit.cache/
coverage
.nyc_output

# Documentation, CI and agent configuration
*.md
README.md
migration-docs/
docs-site/
.github/
.cursor/

# Docker artefacts — read by the daemon and Compose, never from inside the image
Dockerfile
.dockerignore
docker-compose*.yml
docker/

# Version control, editor and OS noise
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db
