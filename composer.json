{
    "name": "pagekit/pagekit",
    "title": "Pagekit",
    "version": "1.0.18",
    "type": "project",
    "description": "The Pagekit CMS",
    "keywords": ["cms", "pagekit"],
    "homepage": "http://pagekit.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Pagekit Team",
            "email": "info@pagekit.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/composer": "~2.2",
        "doctrine/annotations": "~1.14",
        "doctrine/dbal": "~2.13",
        "doctrine/cache": "~1.13",
        "paragonie/random-lib": "~2.0.1",
        "paragonie/sodium_compat": "~1.21",
        "php-debugbar/php-debugbar": "~1.23",
        "monolog/monolog": "~2.1.1",
        "nikic/php-parser": "~5.4",
        "psr/log": "~1.1.3",
        "psr/cache": "~1",
        "symfony/mailer": "~5.4",
        "symfony/error-handler": "~5.4",
        "symfony/finder": "~5.4",
        "symfony/http-foundation": "~5.4",
        "symfony/framework-bundle": "~5.4",
        "symfony/http-kernel": "~5.4",
        "symfony/routing": "~5.4",
        "symfony/stopwatch": "~5.4",
        "symfony/console": "~5.4",
        "symfony/filesystem": "~5.4",
        "symfony/process": "~5.4",
        "symfony/string": "~5.4",
        "symfony/deprecation-contracts": "~2.5",
        "symfony/service-contracts": "~2.5",
        "symfony/templating": "~5.4",
        "symfony/translation": "~5.4",
        "twig/twig": "~3.11.3",
        "symfony/twig-bridge": "~5.4"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "ext-simplexml": "*",
        "ext-pdo": "*",
        "doctrine/data-fixtures": "^1.6",
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "~5.4",
        "symfony/var-dumper": "~5.4",
        "symfony/web-profiler-bundle": "~5.4",
        "symfony/browser-kit": "~5.4",
        "symfony/debug-bundle": "~5.4"
    },
    "autoload": {
        "psr-4": {
            "Pagekit\\": "app/modules/application/src",
            "Pagekit\\Installer\\": "app/installer/src",
            "Pagekit\\System\\": "app/system/src",
            "Pagekit\\Config\\": "app/modules/config/src",
            "Pagekit\\Console\\": "app/console/src",
            "Pagekit\\Migration\\": "app/modules/migration/src"
        }
    },
    "config": {
        "vendor-dir": "app/vendor"
    }
}
