# Shared-hosting fallback for hosts whose document root cannot be pointed at
# public/. Every request is forwarded into the webroot unconditionally, so files
# living next to this one (config.php, app/, tmp/) are never served: they are
# rewritten into public/, do not exist there and end up on the 404 page.
# Apache does not inherit parent rewrite rules, so public/.htaccess takes over
# completely once the internal redirect lands inside the webroot.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
