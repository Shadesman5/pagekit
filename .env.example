# Environment for the Docker development stack — development only.
# This is not a production template: production configuration and secret handling
# ship with the production image.
#
# ./docker-setup.sh (docker-setup.ps1 on Windows) copies this file to .env and
# replaces both passwords with generated values. docker-compose.yml reads .env
# directly; nothing else consumes these variables.

# Database, user and grants created by the mysql service on first boot. The
# Pagekit installer connects to host "mysql", port 3306 with these credentials.
MYSQL_DATABASE=pagekit
MYSQL_USER=pagekit
MYSQL_PASSWORD=CHANGEME_USE_SECURE_PASSWORD

# MySQL superuser, also used by phpMyAdmin to sign in.
MYSQL_ROOT_PASSWORD=CHANGEME_USE_SECURE_ROOT_PASSWORD
