{
    "$schema": "app/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/modules/auth/src",
            "app/system/modules/user/src/Model",
            "app/system/modules/user/src/Auth",
            "app/system/modules/user/src/Event"
        ],
        "excludes": [
            "Tests"
        ]
    },
    "logs": {
        "text": "tmp/infection/infection.log",
        "html": "tmp/infection/infection.html",
        "summary": "tmp/infection/summary.log",
        "json": "tmp/infection/infection.json"
    },
    "tmpDir": "tmp/infection",
    "phpUnit": {
        "configDir": ".",
        "customPath": "app/vendor/bin/phpunit"
    },
    "mutators": {
        "@default": true,
        "ReturnRemoval": {
            "ignore": [
                "Pagekit\\Auth\\Handler\\DatabaseHandler::read::50",
                "Pagekit\\Auth\\Handler\\DatabaseHandler::destroy::112"
            ]
        },
        "LogicalAnd": {
            "ignore": [
                "Pagekit\\User\\Event\\LoginAttemptListener::onPreAuthenticate::45"
            ]
        },
        "LogicalOr": {
            "ignore": [
                "Pagekit\\User\\Event\\AccessListener::onConfigureRoute"
            ]
        },
        "CastInt": {
            "ignore": [
                "Pagekit\\User\\Event\\LoginAttemptListener::onPreAuthenticate::45"
            ]
        },
        "DecrementInteger": {
            "ignore": [
                "Pagekit\\User\\Event\\LoginAttemptListener::onPreAuthenticate::45"
            ]
        },
        "IncrementInteger": {
            "ignore": [
                "Pagekit\\User\\Event\\LoginAttemptListener::onPreAuthenticate::45"
            ]
        }
    },
    "minMsi": 80,
    "minCoveredMsi": 80
}
