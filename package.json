{
    "name": "pagekit",
    "engines": {
        "node": ">=20 <23",
        "yarn": "1.x"
    },
    "scripts": {
        "install": "yarn build",
        "build": "node scripts/build-js.mjs && node scripts/copy-assets.mjs && node scripts/build-css.mjs",
        "build:js": "node scripts/build-js.mjs",
        "build:assets": "node scripts/copy-assets.mjs",
        "build:css": "node scripts/build-css.mjs",
        "watch": "node scripts/watch.mjs",
        "cldr": "node scripts/cldr.mjs",
        "lint": "eslint . --ext .js,.vue",
        "lint-watch": "esw . --ext .js,.vue --clear --watch --changed --color",
        "preinstall": "node ./app/scripts/checkYarn.js",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:install": "playwright test tests/e2e/specs/01-setup/installation.spec.js",
        "test:smoke": "playwright test --grep @ci",
        "test:smoke:headed": "playwright test --grep @ci --headed",
        "test:smoke:ui": "playwright test --grep @ci --ui",
        "test:smoke:report": "playwright show-report"
    },
    "dependencies": {
        "blueimp-md5": "~2.19.0",
        "Codemirror": "github:uatrend/codemirror#master",
        "flatpickr": "~4.6.6",
        "ismobilejs": "~1.1.1",
        "JSONStorage": "github:uatrend/JSONStorage#master",
        "lodash": "^4.17.20",
        "marked": "^4.3.0",
        "tinymce": "~5.10.9",
        "uikit": "~3.5.8",
        "vee-validate": "~3.3.11",
        "vue": "~2.7.16",
        "vue-event-manager": "~2.1.3",
        "vue-intl": "github:uatrend/vue-intl#master",
        "vue-nestable": "~2.6.0",
        "vue-resource": "~1.5.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.1",
        "@vitejs/plugin-vue2": "^2.3.4",
        "babel-eslint": "^10.1.0",
        "chokidar": "^3.4.2",
        "cldr-core": "^36.0.0",
        "cldr-localenames-modern": "^36.0.0",
        "dotenv": "^17.2.2",
        "eslint": "^7.10.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^6.13.0",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-vue": "^7.20.0",
        "eslint-watch": "^7.0.0",
        "eslint-webpack-plugin": "^2.1.0",
        "less": "^3.12.2",
        "prettier": "3.9.6",
        "vite": "^7.3.6",
        "vue-eslint-parser": "^7.1.1"
    },
    "resolutions": {
        "chokidar": "^3.4.2",
        "source-map-resolve": "^0.6.0"
    }
}
