{
    "name": "pagekit",
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "node scripts/build.mjs",
        "build:js": "node scripts/build-js.mjs",
        "build:assets": "node scripts/build-assets.mjs",
        "build:css": "node scripts/build-css.mjs",
        "watch": "node scripts/watch.mjs",
        "cldr": "node scripts/cldr.mjs",
        "lint": "eslint .",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:install": "playwright test tests/e2e/specs/01-setup/installation.spec.js",
        "test:smoke": "playwright test --grep @ci",
        "test:smoke:headed": "playwright test --grep @ci --headed",
        "test:smoke:ui": "playwright test --grep @ci --ui",
        "test:smoke:report": "playwright show-report"
    },
    "dependencies": {
        "blueimp-md5": "~2.19.0",
        "Codemirror": "github:uatrend/codemirror#master",
        "flatpickr": "~4.6.6",
        "ismobilejs": "~1.1.1",
        "JSONStorage": "github:uatrend/JSONStorage#master",
        "lodash": "^4.17.20",
        "marked": "^4.3.0",
        "tinymce": "~5.10.9",
        "uikit": "~3.5.8",
        "vee-validate": "~4.15.1",
        "vue": "~2.7.16",
        "vue-event-manager": "~2.1.3",
        "vue-intl": "github:uatrend/vue-intl#master",
        "vue-nestable": "~2.6.0",
        "vue-resource": "~1.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.55.1",
        "@vitejs/plugin-vue2": "^2.3.4",
        "chokidar": "^3.4.2",
        "cldr-core": "^36.0.0",
        "cldr-localenames-modern": "^36.0.0",
        "dotenv": "^17.2.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.7.0",
        "less": "^3.12.2",
        "prettier": "3.9.6",
        "vite": "^7.3.6",
        "vue-eslint-parser": "^10.4.1"
    }
}
