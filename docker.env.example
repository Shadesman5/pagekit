# Docker Environment Configuration for Pagekit
# Copy this file to docker.env and update with your own secure values

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pagekit
DB_USER=pagekit
DB_PASSWORD=CHANGEME_USE_SECURE_PASSWORD

# Application Configuration
APP_ENV=development
APP_DEBUG=true

# URLs
APP_URL=http://localhost:8080
PHPMYADMIN_URL=http://localhost:8081

# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGEME_USE_SECURE_ROOT_PASSWORD

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# SECURITY NOTICE:
# Never use default passwords in production!
# Use a password generator or the provided setup script.
