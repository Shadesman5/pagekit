# Ignor bundles
**/app/bundle/**/*.js

# Ignor assets
/app/assets/*
/app/system/modules/editor/app/assets/*

# Ignor module assets
/app/installer/assets/css/*
/app/system/modules/theme/css/*
/app/system/modules/theme/js/theme.js
/app/system/modules/theme/assets/css/theme.css

# Don't ignore editor assets
!/app/system/modules/editor/app/assets/tinymce_skin

# Ignore vendor folder
/app/vendor/*

# Ignore database and logs
/docker/logs/*
/docker/mysql/data/*
/docker/redis/*
/pagekit*.zip
/pagekit.db
/config.php
/yarn.lock
/composer.lock
/package-lock.json
node_modules
.DS_Store
.idea

# Ignore development/migration documentation
/migration-docs/TODO/*

# Ignore environment files with secrets
docker.env
.env

# Ignore Cursor files
.cursor/rules/push.mdc
.cursor/environment.json

# PHPUnit cache
.phpunit.cache/

# E2E Testing
.playwright-mcp/**/*
/test-results/
.playwright-mcp/*
/playwright-report/**/*
/playwright-smoke-report/**/*
/storage-e2e/
/tmp-e2e/
/tests/e2e/config/test-config.json