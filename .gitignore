# Ignor bundles
**/app/bundle/**/*.js

# Ignor assets
/app/assets/*
/app/system/modules/editor/app/assets/*

# Ignor module assets
/app/installer/assets/css/*
/app/system/modules/theme/css/*
/app/system/modules/theme/js/theme.js
/app/system/modules/theme/assets/css/theme.css

# Don't ignore editor assets
!/app/system/modules/editor/app/assets/tinymce_skin

# Ignore vendor folder
/app/vendor/*

# Ignore database and logs
/docker/logs/*
/docker/mysql/data/*
/docker/redis/*
/pagekit*.zip
/pagekit.db
/config.php
/package-lock.json
node_modules
.DS_Store
.idea

# Ignore development/migration documentation
/migration-docs/TODO/*

# Ignore local planning documents
/planning/

# Exception: agent_prompts for orchestrated task execution (referenced by .cursor/rules)
!/migration-docs/TODO/agent_prompts/
!/migration-docs/TODO/agent_prompts/**
!/migration-docs/TODO/MODERNISATION_STRATEGY.md
!/migration-docs/TODO/PHASE_1_MODERNISING.md
!/migration-docs/TODO/PHASE_2_MODERNISING.md
!/migration-docs/TODO/PHASE_3_MODERNISING.md
!/migration-docs/TODO/PHASE_4_MODERNISING.md

# Exception: V2 orchestrator design doc (referenced by tracked .cursor/rules)
!/migration-docs/TODO/ORCHESTRATOR_WORKFLOW_V2_DESIGN.md

# Ignore environment files with secrets
*.env

# Ignore Cursor secret files
.cursor/secrets.env

# PHPUnit cache
.phpunit.cache/

# PHP-CS-Fixer cache
.php-cs-fixer.cache

# Infection (only infection.json.dist is committed)
/infection.json
/tmp/infection/

# E2E Testing
.playwright-mcp/
/test-results/
/playwright-report/**/*
/storage-e2e/
/tmp-e2e/
/tests/e2e/config/test-config.json

# MkDocs build output (deployed via GitHub Actions)
/docs-site/site/

# MkDocs hook bytecode (local `mkdocs build` / Python)
/docs-site/hooks/__pycache__/

# Local conductor metrics mirror for mkdocs serve (source of truth: .github/conductor/metrics/)
/docs-site/data/conductor-metrics/