# Environment for a production Pagekit installation.
#
# Copy this file to prod.env and fill it in. prod.env is gitignored (*.env), so
# real credentials stay out of the repository:
#
#   cp prod.env.example prod.env
#
# Every variable is optional. What is set here outranks config.php, what is left
# out keeps whatever config.php and the module defaults say. Unlike a commented
# line, an empty value counts as a value and overrides with nothing.

# --- Application -------------------------------------------------------------

# Error reporting and the debug toolbar. Accepts 1/true/on and 0/false/off.
# Never turn this on for a public site: it exposes internals to visitors.
PAGEKIT_DEBUG=0

# Key the installation signs and versions internal values with. The installer
# generates one into config.php; set it here to control it yourself, e.g. to keep
# it identical across replicas. Generate with: openssl rand -hex 32
#PAGEKIT_SECRET=

# --- Database ----------------------------------------------------------------

# Which connection to use: mysql or sqlite.
PAGEKIT_DB_DRIVER=mysql

# MySQL connection. Ignored when the driver is sqlite.
PAGEKIT_DB_HOST=mysql
PAGEKIT_DB_PORT=3306
PAGEKIT_DB_NAME=pagekit
PAGEKIT_DB_USER=pagekit
PAGEKIT_DB_PASSWORD=CHANGEME_USE_SECURE_PASSWORD

# Prefix for Pagekit's tables, so a shared database can host more than one site.
PAGEKIT_DB_PREFIX=pk_

# SQLite database file. Relative paths resolve from the application root; the
# webroot is refused. Point it at persistent storage — in a container that means
# a volume, not the image.
#PAGEKIT_DB_PATH=/var/www/data/pagekit.db

# --- Reverse proxy -----------------------------------------------------------

# The proxies whose X-Forwarded-For/Host/Port/Proto headers describe the real
# request, comma-separated as addresses or CIDR ranges. Required whenever TLS is
# terminated in front of Pagekit, otherwise it builds its URLs from the plain
# HTTP connection it sees. REMOTE_ADDR trusts whichever peer connected — only
# sound when nothing but the proxy can reach the container.
#PAGEKIT_TRUSTED_PROXIES=10.0.0.0/8

# --- Dashboard ---------------------------------------------------------------

# OpenWeatherMap key for the dashboard's location widget, from
# https://openweathermap.org. Without one the widget reports the weather as
# unavailable; nothing else is affected.
#PAGEKIT_WEATHER_API_KEY=
