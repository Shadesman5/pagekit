# Environment for the production Docker stack.
#
# Copy this file to prod.env, fill it in, and hand it to Compose:
#
#   cp prod.env.example prod.env
#   docker compose -f docker-compose.prod.yml --env-file prod.env up -d
#
# prod.env is gitignored (*.env), so real credentials stay out of the repository.
#
# Two kinds of variable live here: the ones Compose reads while it assembles the
# stack — the image tag and the database credentials — and the PAGEKIT_* ones it
# hands to the container. Of the latter, a commented-out variable is not passed on
# at all and leaves config.php and the built-in defaults in charge, while one set
# to nothing still counts as a value and overrides with the empty one — the
# database driver and port aside, which have no empty value to name and are read
# as unset when they arrive blank.

# --- Image -------------------------------------------------------------------

# Which build to run. "develop" moves with the branch; a commit tag (sha-<short>)
# keeps a deployment on one build until it is rolled forward deliberately.
PAGEKIT_IMAGE_TAG=develop

# --- Database server ---------------------------------------------------------

# Database, user and grants the bundled MySQL service creates on the first start
# of an empty volume. The application is pointed at exactly these: its
# PAGEKIT_DB_NAME, PAGEKIT_DB_USER and PAGEKIT_DB_PASSWORD are taken from here, so
# the two sides cannot drift apart.
MYSQL_DATABASE=pagekit
MYSQL_USER=pagekit
MYSQL_PASSWORD=CHANGEME_USE_SECURE_PASSWORD

# MySQL superuser. It stays with the database container; the application signs in
# as the unprivileged user above.
MYSQL_ROOT_PASSWORD=CHANGEME_USE_SECURE_ROOT_PASSWORD

# --- Application -------------------------------------------------------------

# Error reporting and the debug toolbar. Accepts 1/true/on and 0/false/off.
# Never turn this on for a public site: it exposes internals to visitors.
PAGEKIT_DEBUG=0

# Key the installation signs and versions internal values with. The installer
# generates one into config.php; set it here to control it yourself, e.g. to keep
# it identical across replicas. Generate with: openssl rand -hex 32
#PAGEKIT_SECRET=

# --- Database connection -----------------------------------------------------

# Which connection Pagekit opens: mysql or sqlite.
PAGEKIT_DB_DRIVER=mysql

# Prefix for the tables of the MySQL connection, so one database can host more
# than one site.
PAGEKIT_DB_PREFIX=pk_

# Where that server listens. The defaults address the bundled service; point these
# at a server outside this stack and start with "--no-deps web", so that Compose
# does not wait for a database container nothing uses.
#PAGEKIT_DB_HOST=mysql
#PAGEKIT_DB_PORT=3306

# SQLite database file, for a stack that runs the application by itself. The image
# already puts it on the data volume, so this is here to move it - and it has to
# stay on that volume, the only writable place in the image. Relative paths
# resolve from the application root, which is read-only here; the webroot is
# refused outright.
#PAGEKIT_DB_PATH=/var/www/data/pagekit.db

# --- Reverse proxy -----------------------------------------------------------

# The proxies whose X-Forwarded-For/Host/Port/Proto headers describe the real
# request, comma-separated as addresses or CIDR ranges. Required whenever TLS is
# terminated in front of Pagekit, otherwise it builds its URLs from the plain
# HTTP connection it sees. REMOTE_ADDR trusts whichever peer connected — only
# sound when nothing but the proxy can reach the container.
#
# Setting it is also what makes Apache accept X-Forwarded-Proto as proof that a
# request arrived over TLS. A container started without it redirects every plain
# request to HTTPS whatever headers come with it, so a client that reaches the
# port itself cannot send its way past the redirect.
#PAGEKIT_TRUSTED_PROXIES=10.0.0.0/8

# --- Dashboard ---------------------------------------------------------------

# OpenWeatherMap key for the dashboard's location widget, from
# https://openweathermap.org. Without one the widget reports the weather as
# unavailable; nothing else is affected.
#PAGEKIT_WEATHER_API_KEY=

# --- Container startup -------------------------------------------------------

# Where the container keeps what has to outlive it: config.php and, for an SQLite
# installation, the database file. The stack mounts its volume at this default and
# does not pass the variable on: moving the directory means moving that mount too,
# and needs a writable application root, which the image deliberately lacks.
#PAGEKIT_DATA_DIR=/var/www/data

# Install on the first start instead of walking through the web installer. The
# database comes from the variables above, the administrator from the ones below;
# a start that finds an existing installation leaves it untouched.
#PAGEKIT_AUTO_SETUP=1

# The administrator account the installation creates. The password is required
# for an automatic install and is read while installing, never afterwards.
#PAGEKIT_ADMIN_USERNAME=admin
#PAGEKIT_ADMIN_PASSWORD=
#PAGEKIT_ADMIN_MAIL=admin@example.com

# Title and locale the new site starts with; both are editable in the admin
# afterwards.
#PAGEKIT_SITE_TITLE=Pagekit
#PAGEKIT_LOCALE=en_GB

# Apply pending database migrations on every start. Leave it off to keep the
# moment the schema of a live site changes a decision of yours. For one container
# at a time: replicas start together and would migrate the same database at once,
# so a stack that scales out wants the migration run as a job of its own —
# "docker compose ... run --rm web php pagekit migration:migrate" — before the
# new build comes up.
#PAGEKIT_AUTO_MIGRATE=1
